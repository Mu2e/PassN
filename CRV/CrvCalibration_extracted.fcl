#
# calibrates CRV channels
#
#include "Offline/fcl/standardProducers.fcl"
#include "Offline/fcl/standardServices.fcl"
#include "Offline/CRVReco/fcl/prolog.fcl"

process_name : calibrateWideband

source :
{
  module_type : RootInput
}
services :
{
  @table::Services.Reco
}

physics: {
  producers :
  {
    CrvDigi :
    {
      module_type   : CrvDigisFromArtdaqFragmentsFEBII
      diagLevel     : 0
      useROC4asROC2 : true
    }
    CrvRecoPulses: @local::CrvRecoPulses
  }
  analyzers:
  {
    CrvCalibration: @local::CrvCalibration
  }

  TriggerPath : [ CrvDigi, CrvRecoPulses ]
  EndPath :     [ CrvCalibration ]
  trigger_paths : [ TriggerPath ]
  end_paths :     [ EndPath ]
}

physics.producers.CrvRecoPulses.minPedestalDifference          : -3.0     //prevents smeared-out calibration plots for some channels
physics.producers.CrvRecoPulses.maxPedestalDifference          :  3.0     //prevents smeared-out calibration plots for some channels
physics.producers.CrvRecoPulses.minAdjustedPedestalDifference  : -10000.0
physics.producers.CrvRecoPulses.maxAdjustedPedestalDifference  :  10000.0
physics.producers.CrvRecoPulses.maxPulseLength                 : 12       //only use single hit pulses for dark count calibration
physics.producers.CrvRecoPulses.pedestalAdjustment             :  true    //precision pedestal adjustment for dark count calibration
physics.producers.CrvRecoPulses.pedestalUndershootThreshold    :  10000.0 //forces it to use the adjusted precision pedestal instead of the simple undershoot adjustment
physics.producers.CrvRecoPulses.minADCdifference               :  5.0     //minimum ADC difference above pedestal to be considered for reconstruction
physics.producers.CrvRecoPulses.defaultBeta                    : 10.0
physics.producers.CrvRecoPulses.ignoreChannels                 :  false
physics.analyzers.CrvCalibration.tmpDBfileName                 : "calibrationExtracted.txt"

services.TFileService.fileName     : "calibrationExtracted.root"
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_common_extracted.txt"
services.ProditionsService.crvStatus.useDb : false
services.ProditionsService.crvCalib.useDb  : true
services.DbService.verbose  : 0
services.DbService.textFile : ["pedestalsExtracted.txt","Offline/CRVConditions/data/calibTime_extracted_default.txt"]  //need to use new pedestals and default timeoffsets
services.TimeTracker.printSummary : true
services.scheduler.wantSummary    : true
services.message.destinations.log.outputStatistics : true
