#include "Production/JobConfig/reco/Extracted.fcl"

physics.RecoPath: [
  makeSH,
  SimpleTimeCluster,
  CosmicShowerFilter,
  LineFinder,
  KKLine,
  KLFilter,
  SelectReco
   ]

# Tracker-only RecoPath: do not schedule the KLPath that Extracted.fcl built from its full RecoPath
physics.trigger_paths : [ RecoPath ]

#include "PassN/Tracker/TrkReco_epilog.fcl"

# temporary calibrations
#include "PassN/Tracker/trackercalibrations.fcl"
services.DbService.purpose : "TRACKER_VST"
services.DbService.version: v2_0
services.DbService.textFile : [
  "Offline/TrackerConditions/data/TrkPanelMap.txt",
  "PassN/Tracker/trackercalibrations.txt"]
